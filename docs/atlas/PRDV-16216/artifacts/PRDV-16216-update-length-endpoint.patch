+import { ApiProperty } from '@nestjs/swagger';
+
+export class UpdateProceedingFileLengthResponseDTO {
+	@ApiProperty({
+		description: 'The ID of the file whose length was recorded',
+		example: 12345,
+	})
+	id!: number;
+
+	@ApiProperty({
+		description: 'The media duration now stored on the file, in whole seconds',
+		example: 8040,
+	})
+	length!: number;
+
+	@ApiProperty({
+		description:
+			'Whether this request wrote the value. False when the file already had a length and was left unchanged.',
+		example: true,
+	})
+	updated!: boolean;
+}
