+import { Injectable, NotFoundException } from '@nestjs/common';
+import {
+	InjectLogger,
+	LoggerPort,
+} from '@planetdepos/pathfinder-observability-pkg';
+import { ProceedingFileRepository } from 'src/proceedings/infrastructure/repositories/proceeding-file.repository';
+import { UpdateProceedingFileLengthProjection } from './update-proceeding-file-length.projection';
+
+/**
+ * Records a browser-measured media duration on an existing file row. The value
+ * is written only while the file's length is still null, so a value already set
+ * by the upload path (originals) or an earlier viewer (transcoded files) is
+ * never overwritten. The measured-only, whole-seconds contract mirrors the
+ * upload capture path — the only other writer of files.length.
+ */
+@Injectable()
+export class UpdateProceedingFileLengthTS {
+	constructor(
+		@InjectLogger(UpdateProceedingFileLengthTS.name)
+		private readonly logger: LoggerPort,
+		private readonly proceedingFileRepository: ProceedingFileRepository,
+	) {}
+
+	async apply(
+		fileId: number,
+		length: number,
+		modifiedUserIdentity: string,
+	): Promise<UpdateProceedingFileLengthProjection> {
+		try {
+			const file =
+				await this.proceedingFileRepository.fetchFileById(fileId);
+			if (!file) {
+				throw new NotFoundException('File not found');
+			}
+			if (file.length != null) {
+				return { id: fileId, length: file.length, updated: false };
+			}
+			const updated =
+				await this.proceedingFileRepository.updateFileLengthWhenNull(
+					fileId,
+					length,
+					modifiedUserIdentity,
+				);
+			return { id: fileId, length, updated };
+		} catch (error) {
+			this.logger.error(error);
+			throw error;
+		}
+	}
+}
