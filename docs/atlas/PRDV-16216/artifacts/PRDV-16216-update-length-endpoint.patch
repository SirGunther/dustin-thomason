+import { Patch, Param, Body, ParseIntPipe, UseGuards } from '@nestjs/common';
+
+import { ProceedingsController } from 'src/proceedings/application/controllers/proceedings.controller';
+import { ProceedingService } from 'src/proceedings/domain/services/proceeding-service/proceeding.service';
+import { UpdateProceedingFileLengthRequestDTO } from './update-proceeding-file-length.request.dto';
+import { VerifiedUserDecorator } from 'src/generic/auth/application/decorators/verified-user.decorator';
+import { AuthUser } from 'src/generic/auth/constants';
+import { FileId } from 'src/shared/shared-entities/entities/files/file.entity';
+import { ReadProceedingFileAuthGuard } from 'src/proceedings/application/guards/permissions/single-proceeding-file-auth-guard/read-proceeding-file-auth.guard';
+import { UpdateProceedingFileLengthSwagger } from './update-proceeding-file-length.action.swagger';
+
+@ProceedingsController()
+export class UpdateProceedingFileLengthAction {
+	constructor(private readonly service: ProceedingService) {}
+
+	@Patch('/file/:fileId/length')
+	@UpdateProceedingFileLengthSwagger()
+	@UseGuards(ReadProceedingFileAuthGuard)
+	async apply(
+		@Param('fileId', new ParseIntPipe({ errorHttpStatusCode: 400 }))
+		fileId: FileId,
+		@Body() dto: UpdateProceedingFileLengthRequestDTO,
+		@VerifiedUserDecorator() user: AuthUser,
+	) {
+		return await this.service.updateProceedingFileLength(
+			fileId,
+			dto.length,
+			user,
+		);
+	}
+}
