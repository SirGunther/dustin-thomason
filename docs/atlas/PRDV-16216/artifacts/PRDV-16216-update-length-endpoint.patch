+import { ApiProperty } from '@nestjs/swagger';
+import { Transform } from 'class-transformer';
+import { IsInt, IsNotEmpty, IsNumber, Min } from 'class-validator';
+import { transformToInt } from 'src/generic/application/transforms/parse-int.transform';
+
+export class UpdateProceedingFileLengthRequestDTO {
+	@ApiProperty({
+		description:
+			'Browser-measured media duration of this file’s own bytes, in whole seconds. Must be a genuine measurement of the file in this row — never a value copied from another file.',
+		example: 8040,
+		minimum: 1,
+	})
+	@IsNotEmpty({ message: 'length must not be empty' })
+	@IsInt({ message: 'length must be an integer number of seconds' })
+	@Min(1, { message: 'length must be greater than 0' })
+	length!: number;
+
+	@ApiProperty({
+		description: 'The track type ID for the file',
+		example: 2,
+	})
+	@IsNotEmpty({ message: 'trackTypeId must not be empty' })
+	@Transform(transformToInt)
+	@IsNumber({ allowNaN: false, allowInfinity: false })
+	trackTypeId!: number;
+}
