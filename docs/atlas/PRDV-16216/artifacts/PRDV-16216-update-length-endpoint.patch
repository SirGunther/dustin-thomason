+	/**
+	 * Records a browser-measured media duration on a file, but only while the
+	 * column is still null. The `length IS NULL` predicate lives in the UPDATE
+	 * itself so the database — not application code — picks a single winner when
+	 * two viewers measure the same file concurrently; the losing write matches no
+	 * row and is a no-op. Returns whether this call was the one that wrote.
+	 */
+	async updateFileLengthWhenNull(
+		id: number,
+		length: number,
+		modifiedUserIdentity: string,
+	): Promise<boolean> {
+		const result = await this.repo.update(
+			{ id: id as FileId, length: IsNull() },
+			{ length, modifiedUserIdentity, updatedAt: new Date() },
+		);
+		return (result.affected ?? 0) > 0;
+	}
