+import { Injectable } from '@nestjs/common';
+import { ACTIONS_TYPES } from 'src/generic/auth/domain/entities/permission.entity';
+import { AbstractSingleProceedingFileAuthGuard } from './abstract-single-proceeding-file-auth.guard';
+
+/**
+ * Read-level authorization for single-file endpoints. Matches the access level
+ * of file download, so any viewer who can fetch a file's bytes to measure them
+ * can also record the measured duration back to it.
+ */
+@Injectable()
+export class ReadProceedingFileAuthGuard extends AbstractSingleProceedingFileAuthGuard {
+	protected requiredAccessLevel = ACTIONS_TYPES.READ;
+}
