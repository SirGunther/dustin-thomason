+import { applyDecorators } from '@nestjs/common';
+import { ApiBody, ApiOperation, ApiParam, ApiResponse } from '@nestjs/swagger';
+import { UpdateProceedingFileLengthRequestDTO } from './update-proceeding-file-length.request.dto';
+import { UpdateProceedingFileLengthResponseDTO } from './update-proceeding-file-length.response.dto';
+
+export const UpdateProceedingFileLengthSwagger = () => {
+	return applyDecorators(
+		ApiOperation({
+			summary: 'Record a proceeding file’s media duration',
+			description:
+				'Records a browser-measured media duration (whole seconds) on a proceeding file. The value is written only while the file’s length is still null, so an existing value is never overwritten. Used to backfill Nova-transcoded files, whose rows are created without a duration.',
+		}),
+		ApiParam({
+			name: 'fileId',
+			type: 'number',
+			description: 'The unique identifier of the file to record a length for',
+			example: 12345,
+		}),
+		ApiBody({
+			type: UpdateProceedingFileLengthRequestDTO,
+			description: 'The measured media duration in whole seconds',
+		}),
+		ApiResponse({
+			status: 200,
+			description: 'Length recorded (or left unchanged if already set)',
+			type: UpdateProceedingFileLengthResponseDTO,
+		}),
+		ApiResponse({
+			status: 400,
+			description: 'Invalid request',
+			schema: {
+				type: 'object',
+				properties: {
+					statusCode: { type: 'number', example: 400 },
+					message: {
+						type: 'string',
+						example: 'length must be greater than 0',
+					},
+					error: { type: 'string', example: 'Bad Request' },
+				},
+			},
+		}),
+		ApiResponse({
+			status: 403,
+			description: 'Caller is not authorized to read this file',
+			schema: {
+				type: 'object',
+				properties: {
+					statusCode: { type: 'number', example: 403 },
+					message: { type: 'string', example: 'Forbidden' },
+					error: { type: 'string', example: 'Forbidden' },
+				},
+			},
+		}),
+		ApiResponse({
+			status: 404,
+			description: 'File not found',
+			schema: {
+				type: 'object',
+				properties: {
+					statusCode: { type: 'number', example: 404 },
+					message: { type: 'string', example: 'File not found' },
+					error: { type: 'string', example: 'Not Found' },
+				},
+			},
+		}),
+		ApiResponse({
+			status: 500,
+			description: 'Internal server error',
+			schema: {
+				type: 'object',
+				properties: {
+					statusCode: { type: 'number', example: 500 },
+					message: {
+						type: 'string',
+						example: 'Failed to record file length',
+					},
+					error: { type: 'string', example: 'Internal Server Error' },
+				},
+			},
+		}),
+	);
+};
