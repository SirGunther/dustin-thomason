+import { Test, TestingModule } from '@nestjs/testing';
+import { UpdateProceedingFileLengthAction } from '../update-proceeding-file-length.action';
+import { ProceedingService } from 'src/proceedings/domain/services/proceeding-service/proceeding.service';
+import { ReadProceedingFileAuthGuard } from 'src/proceedings/application/guards/permissions/single-proceeding-file-auth-guard/read-proceeding-file-auth.guard';
+import { FileId } from 'src/shared/shared-entities/entities/files/file.entity';
+import { createMock, createMockId } from 'src/test-utils/test-utils';
+import { createMockAuthUser } from 'src/generic/auth/test-utils';
+import { UpdateProceedingFileLengthRequestDTO } from '../update-proceeding-file-length.request.dto';
+
+describe('given: UpdateProceedingFileLengthAction', () => {
+	let target: UpdateProceedingFileLengthAction;
+	let proceedingServiceMock: jest.Mocked<ProceedingService>;
+
+	const mockUser = createMockAuthUser();
+
+	beforeEach(async () => {
+		proceedingServiceMock = createMock<ProceedingService>({
+			updateProceedingFileLength: jest.fn(),
+		});
+		const module: TestingModule = await Test.createTestingModule({
+			providers: [
+				UpdateProceedingFileLengthAction,
+				{
+					provide: ProceedingService,
+					useValue: proceedingServiceMock,
+				},
+			],
+		})
+			.overrideGuard(ReadProceedingFileAuthGuard)
+			.useValue({ canActivate: () => true })
+			.compile();
+		target = module.get<UpdateProceedingFileLengthAction>(
+			UpdateProceedingFileLengthAction,
+		);
+	});
+
+	describe('when: applying the action', () => {
+		test('then: should delegate the file id, measured length, and user to the service', async () => {
+			// Arrange
+			const fileId = createMockId<FileId>();
+			const dto: UpdateProceedingFileLengthRequestDTO = {
+				length: 8040,
+				trackTypeId: 2,
+			};
+			const expectedProjection = {
+				id: fileId as number,
+				length: 8040,
+				updated: true,
+			};
+			proceedingServiceMock.updateProceedingFileLength.mockResolvedValue(
+				expectedProjection,
+			);
+
+			// Act
+			const result = await target.apply(fileId, dto, mockUser);
+
+			// Assert
+			expect(
+				proceedingServiceMock.updateProceedingFileLength,
+			).toHaveBeenNthCalledWith(1, fileId, dto.length, mockUser);
+			expect(result).toBe(expectedProjection);
+		});
+
+		test('then: should propagate service errors', async () => {
+			// Arrange
+			const fileId = createMockId<FileId>();
+			const dto: UpdateProceedingFileLengthRequestDTO = {
+				length: 8040,
+				trackTypeId: 2,
+			};
+			const expectedError = new Error('File not found');
+			proceedingServiceMock.updateProceedingFileLength.mockRejectedValue(
+				expectedError,
+			);
+
+			// Act & Assert
+			await expect(target.apply(fileId, dto, mockUser)).rejects.toThrow(
+				expectedError,
+			);
+		});
+	});
+});
