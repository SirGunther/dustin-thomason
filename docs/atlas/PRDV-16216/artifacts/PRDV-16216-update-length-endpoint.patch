@@ -0,0 +1,98 @@
+import 'reflect-metadata';
+import { plainToInstance } from 'class-transformer';
+import { validate } from 'class-validator';
+import { UpdateProceedingFileLengthRequestDTO } from '../update-proceeding-file-length.request.dto';
+
+const buildDto = (
+	overrides: Record<string, unknown>,
+): UpdateProceedingFileLengthRequestDTO =>
+	plainToInstance(UpdateProceedingFileLengthRequestDTO, {
+		length: 8040,
+		trackTypeId: 2,
+		...overrides,
+	});
+
+const findErrorProperties = async (
+	dto: UpdateProceedingFileLengthRequestDTO,
+): Promise<string[]> => {
+	const errors = await validate(dto);
+	return errors.map((error) => error.property);
+};
+
+describe('given: UpdateProceedingFileLengthRequestDTO', () => {
+	describe('when: the payload is a whole-second measurement', () => {
+		test('then: should pass validation', async () => {
+			// Arrange
+			const dto = buildDto({ length: 8040 });
+
+			// Act
+			const errors = await validate(dto);
+
+			// Assert
+			expect(errors).toHaveLength(0);
+		});
+	});
+
+	describe('when: length is not an integer', () => {
+		test('then: should fail validation', async () => {
+			// Arrange
+			const dto = buildDto({ length: 8040.7 });
+
+			// Act
+			const properties = await findErrorProperties(dto);
+
+			// Assert
+			expect(properties).toContain('length');
+		});
+	});
+
+	describe('when: length is zero or negative', () => {
+		test('then: should fail validation for zero', async () => {
+			// Arrange
+			const dto = buildDto({ length: 0 });
+
+			// Act
+			const properties = await findErrorProperties(dto);
+
+			// Assert
+			expect(properties).toContain('length');
+		});
+
+		test('then: should fail validation for a negative value', async () => {
+			// Arrange
+			const dto = buildDto({ length: -5 });
+
+			// Act
+			const properties = await findErrorProperties(dto);
+
+			// Assert
+			expect(properties).toContain('length');
+		});
+	});
+
+	describe('when: length is missing', () => {
+		test('then: should fail validation', async () => {
+			// Arrange
+			const dto = buildDto({ length: undefined });
+
+			// Act
+			const properties = await findErrorProperties(dto);
+
+			// Assert
+			expect(properties).toContain('length');
+		});
+	});
+
+	describe('when: trackTypeId is missing', () => {
+		test('then: should fail validation', async () => {
+			// Arrange
+			const dto = buildDto({ trackTypeId: undefined });
+
+			// Act
+			const properties = await findErrorProperties(dto);
+
+			// Assert
+			expect(properties).toContain('trackTypeId');
+		});
+	});
+});
